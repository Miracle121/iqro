# HBVM Agent Configuration
# Copy this file to .env and update the values

# Backend connection settings
HBVM_BACKEND_URL=https://api.hbvm.local
HBVM_API_KEY=your_api_key_here

# Agent identification (auto-generated if not provided)
HBVM_AGENT_ID=
HBVM_HOSTNAME=

# Scanning configuration
HBVM_SCAN_INTERVAL=24
HBVM_MAX_SCAN_DURATION=60

# Security settings
HBVM_VERIFY_SSL=true
HBVM_REQUEST_TIMEOUT=30

# Logging
HBVM_LOG_LEVEL=INFO
HBVM_LOG_FILE=/var/log/hbvm-agent.log

# Data directories
HBVM_DATA_DIR=/var/lib/hbvm-agent
HBVM_CACHE_DIR=/var/cache/hbvm-agent