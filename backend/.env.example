# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/hbvm
MONGODB_OPTIONS=

# Redis Configuration (for caching and queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# API Keys
API_KEY_SECRET=your_api_key_secret_here
MASTER_API_KEY=your_master_api_key_here

# CVE Data Sources
NVD_API_KEY=your_nvd_api_key_here
VULNERS_API_KEY=your_vulners_api_key_here
CVE_UPDATE_INTERVAL=6h

# External Services
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM=noreply@hbvm.local

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100
CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=info
LOG_FILE=logs/hbvm-backend.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5

# Performance
WORKER_PROCESSES=auto
CACHE_TTL=300
MAX_SCAN_SIZE=100MB

# Features
ENABLE_SWAGGER=true
ENABLE_METRICS=true
ENABLE_DEBUG=false